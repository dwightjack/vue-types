{
  "name": "vue-types-monorepo",
  "description": "VueTypes Monorepo",
  "author": "Marco Solazzi",
  "license": "MIT",
  "homepage": "https://vue-types.codeful.dev/",
  "type": "module",
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.12.1",
    "pnpm": "^12.14.0"
  },
  "scripts": {
    "examples:dev": "pnpm --filter=vue-types run build && pnpm --filter=examples start",
    "docs:dev": "pnpm --filter=docs run dev",
    "nuxt:dev": "pnpm --filter=vue-types-nuxt stub && pnpm --filter=vue-types-nuxt-playground dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dwightjack/vue-types.git"
  },
  "bugs": "https://github.com/dwightjack/vue-types/issues",
  "devDependencies": {
    "@changesets/cli": "3",
    "@vitest/coverage-v8": "5.0.5",
    "happy-dom": "21.0.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "publint": "^0.3.25",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
